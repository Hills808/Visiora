# Server only. Copy to .env locally; never send the real file in chat or commit it.
OPENAI_API_KEY=
VISIORA_PROVIDER=luna
VISIORA_LUNA_ENABLED=0
VISIORA_DAILY_USD=0
# Normal limit remains US$2/day; approved 2026-10-23 US$10 exception is automatic in server policy when this is >0.
# Leave blank until model pricing/image billing and reservation policy are reviewed.
VISIORA_PRICING_CONFIRMED=
PORT=8080
# For a protected HTTPS deployment, deploy/compose.yml sets VISIORA_PUBLIC_ORIGIN from deploy/.env.
