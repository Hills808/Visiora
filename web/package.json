{
  "name": "visiora",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Ambientacao por voz pt-BR com processamento local",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/serve.mjs",
    "test": "node tools/test.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node tools/check.mjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src public/index.html public/styles.css public/sw.js tools tests",
    "simulate": "node tools/simulate.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "dev:luna": "node --env-file-if-exists=.env server/gateway.mjs",
    "luna:models": "node tools/luna-models.mjs",
    "test:luna": "node --test tests/luna*.test.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "prettier": "3.6.2",
    "playwright-core": "1.64.1"
  }
}
