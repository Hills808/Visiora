{
  "type": "object",
  "properties": {
    "scene": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 60,
              "minLength": 1
            },
            "support": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 24,
                "pattern": "^[a-z0-9-]{1,24}$"
              },
              "maxItems": 12,
              "minItems": 1
            }
          },
          "required": ["label", "support"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[a-z0-9-]{1,24}$"
          },
          "kind": {
            "type": "string",
            "enum": ["person", "object", "text"]
          },
          "label": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "description": "Sintagma nominal curto, sem espaços no início/fim, HTML, instruções ou pontuação final. Unicode NFC."
          },
          "uncertain": {
            "type": "boolean"
          },
          "box": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "maximum": 1,
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "maximum": 1,
                    "exclusiveMinimum": 0
                  }
                },
                "required": ["x", "y", "width", "height"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "x,y são canto superior esquerdo; x+width e y+height devem ser <=1. Se não localizável, null. Nunca trocar centro por canto."
          },
          "article": {
            "type": "string",
            "enum": ["um", "uma"]
          }
        },
        "required": ["id", "kind", "label", "uncertain", "box", "article"],
        "additionalProperties": false
      },
      "maxItems": 12
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[a-z0-9-]{1,24}$"
          },
          "object": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[a-z0-9-]{1,24}$"
          },
          "description": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          }
        },
        "required": ["subject", "object", "description"],
        "additionalProperties": false
      },
      "maxItems": 12
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160,
        "minLength": 1
      },
      "maxItems": 6
    }
  },
  "required": ["scene", "observations", "relations", "limitations"],
  "additionalProperties": false
}
